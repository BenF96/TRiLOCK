APP_NAME="TRILOCK Access Control"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-trilock-domain.com

# Only used by `php artisan serve` in local dev. 0.0.0.0 lets ESP32 devices on
# the LAN reach the server — the default 127.0.0.1 blocks them and makes
# devices show "offline" forever even while active.
SERVER_HOST=0.0.0.0

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# ===================================================================
# SUPABASE CLOUD DATABASE (PostgreSQL)
# ===================================================================
DB_CONNECTION=pgsql
DB_HOST=db.your-project-ref.supabase.co
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres
DB_PASSWORD=CHANGE_ME
DB_SSLMODE=require

# Use the Supabase Transaction Pooler (port 6543), not the direct connection,
# once you're running more than one app instance — each PHP-FPM worker across
# every container opens its own Postgres connection, and Supabase's direct
# connection limit is low. The pooler is what makes horizontal scaling safe here.
# DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require

# ===================================================================
# SUPABASE REST API & AUTH (Optional)
# ===================================================================
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ===================================================================
# PRODUCTION SESSIONS, CACHE & QUEUES
# ===================================================================
# Redis backs sessions/cache/queue so any number of app containers behind a
# load balancer share the same state. Falls back to the "database" driver
# (see docker-compose.yml comments) if you're running a single instance and
# don't want to operate Redis.
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=redis
CACHE_STORE=redis

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Comma-separated list of trusted reverse-proxy/load-balancer IPs (or CIDR
# ranges) so Laravel reads the real client IP/scheme from X-Forwarded-*
# headers. Use "*" when the app is only reachable through the LB/nginx
# (e.g. inside a private network or behind a managed cloud LB).
TRUSTED_PROXIES=*

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="security@trilock.lab"
MAIL_FROM_NAME="${APP_NAME}"

# Only needed if FILESYSTEM_DISK=s3 below. RFID/fingerprint enrollment photos
# and ESP32-CAM captures live on FILESYSTEM_DISK. "public" (a local disk) only
# works with a single app instance, or multiple instances sharing one mounted
# volume (docker-compose.yml does this by default). Switch to "s3" once you're
# running app containers across multiple hosts with no shared volume.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
VITE_APP_NAME="${APP_NAME}"

# ===================================================================
# TRILOCK IOT HARDWARE & SECURITY SETTINGS
# ===================================================================
TRILOCK_DEVICE_API_KEY=CHANGE_ME
TRILOCK_ESP32_URL=http://192.168.1.106
TRILOCK_ENROLLMENT_TIMEOUT=60
TRILOCK_MAX_FAILED_ATTEMPTS=5
TRILOCK_LOCKOUT_DURATION=60
# Must match OFFLINE_PIN_SALT in firmware/esp32_main_controller.ino exactly —
# changing this invalidates every device's cached offline PIN hashes until
# their next /api/offline-sync.
TRILOCK_OFFLINE_PIN_SALT=trilock_offline_salt_change_me
